# Salin file ini menjadi .env, lalu sesuaikan dengan konfigurasi lokal.
# Jangan masukkan file .env ke GitHub atau membagikan kredensial.
PORT=3000
APP_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=database_perpustakaan

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Isi dengan nama model yang benar-benar tersedia pada komputer.
# Periksa menggunakan: ollama list
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=120000
